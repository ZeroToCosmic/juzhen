PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
# 异步 MySQL 连接格式：mysql+asyncmy://用户名:密码@127.0.0.1:3306/数据库名?charset=utf8mb4
DATABASE_URL=mysql+asyncmy://root:password@127.0.0.1:3306/automation?charset=utf8mb4
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_CONCURRENCY=4
# 可选：自定义评论规则 JSON 文件路径
# COMMENT_RULES_PATH=data/content/comment_rules.json

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:juzhen:remote-actions:work-order:v1",
  "title": "Remote action WorkOrder v1",
  "type": "object",
  "$defs": {
    "definition": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^act_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "maxLength": 30
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_checksum": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        },
        "release_checksum": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        },
        "definition_schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "parameter_schema": {"type": "object", "maxProperties": 128},
        "result_schema": {"type": "object", "maxProperties": 128},
        "snapshot": {"type": "object", "maxProperties": 256, "x-maxBytes": 524288},
        "execution_defaults": {"type": "object", "maxProperties": 128}
      },
      "required": [
        "action_id",
        "revision",
        "content_checksum",
        "release_checksum",
        "definition_schema_version",
        "parameter_schema",
        "result_schema",
        "snapshot",
        "execution_defaults"
      ],
      "additionalProperties": false
    },
    "account_reservation": {
      "type": "object",
      "properties": {
        "resource_key": {
          "type": "string",
          "pattern": "^account:.+$",
          "maxLength": 512
        },
        "resource_type": {"const": "account"},
        "account_id": {
          "type": "string",
          "pattern": "^acct_[A-Za-z0-9_-]{1,75}$",
          "maxLength": 80
        }
      },
      "required": ["resource_key", "resource_type", "account_id"],
      "additionalProperties": false
    },
    "window_reservation": {
      "type": "object",
      "properties": {
        "resource_key": {
          "type": "string",
          "pattern": "^window:.+:.+$",
          "maxLength": 512
        },
        "resource_type": {"const": "window"},
        "device_id": {
          "type": "string",
          "pattern": "^dev_[A-Za-z0-9_-]{1,76}$",
          "maxLength": 80
        },
        "window_ref": {
          "type": "string",
          "pattern": "^win_[A-Za-z0-9_-]{1,76}$",
          "maxLength": 80
        }
      },
      "required": ["resource_key", "resource_type", "device_id", "window_ref"],
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "properties": {
        "effect_id": {
          "type": "string",
          "pattern": "^effect_[A-Za-z0-9_-]{1,73}$",
          "maxLength": 80
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^effect_[A-Za-z0-9_-]{1,73}$",
            "maxLength": 80
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "result_schema": {"type": "object", "maxProperties": 128}
      },
      "required": ["effect_id", "dependencies", "result_schema"],
      "additionalProperties": false
    },
    "execution_policy": {
      "type": "object",
      "properties": {
        "deadline_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "pre_effect_max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "cancel_mode": {"const": "SAFE_CHECKPOINT"},
        "evidence_types": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 64},
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "deadline_at",
        "pre_effect_max_attempts",
        "cancel_mode",
        "evidence_types"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "protocol_version": {"const": "1.0"},
    "command_id": {
      "type": "string",
      "pattern": "^cmd_[A-Za-z0-9_-]{1,76}$",
      "maxLength": 80
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_[A-Za-z0-9_-]{1,75}$",
      "maxLength": 80
    },
    "work_order_id": {
      "type": "string",
      "pattern": "^wo_[A-Za-z0-9_-]{1,77}$",
      "maxLength": 80
    },
    "device_id": {
      "type": "string",
      "pattern": "^dev_[A-Za-z0-9_-]{1,76}$",
      "maxLength": 80
    },
    "lease_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "executor_kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "definition": {"$ref": "#/$defs/definition"},
    "runtime_params": {"type": "object", "maxProperties": 128, "x-maxBytes": 262144},
    "resource_reservations": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/account_reservation"},
          {"$ref": "#/$defs/window_reservation"}
        ]
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "effect_plan": {
      "type": "array",
      "items": {"$ref": "#/$defs/effect"},
      "maxItems": 256,
      "uniqueItems": true
    },
    "execution_policy": {"$ref": "#/$defs/execution_policy"}
  },
  "required": [
    "protocol_version",
    "command_id",
    "task_id",
    "work_order_id",
    "device_id",
    "lease_generation",
    "executor_kind",
    "definition",
    "runtime_params",
    "resource_reservations",
    "effect_plan",
    "execution_policy"
  ],
  "x-maxDepth": 32,
  "additionalProperties": false
}

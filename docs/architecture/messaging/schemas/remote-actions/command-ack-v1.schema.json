{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:juzhen:remote-actions:command-ack:v1",
  "title": "Remote action command ACK v1",
  "type": "object",
  "properties": {
    "command_id": {"type": "string", "pattern": "^cmd_[A-Za-z0-9_-]{1,76}$", "maxLength": 80},
    "work_order_id": {"type": "string", "pattern": "^wo_[A-Za-z0-9_-]{1,77}$", "maxLength": 80},
    "ack_kind": {
      "enum": ["RECEIVED", "ACCEPTED", "REJECTED", "ALREADY_TERMINAL"]
    },
    "run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9_-]{1,76}$", "maxLength": 80},
    "persisted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "maxLength": 24
    },
    "rejection_code": {"type": "string", "minLength": 1, "maxLength": 64},
    "result_event_id": {"type": "string", "pattern": "^evt_[A-Za-z0-9_-]{1,76}$", "maxLength": 80}
  },
  "required": ["command_id", "work_order_id", "ack_kind", "run_id", "persisted_at"],
  "allOf": [
    {
      "if": {"properties": {"ack_kind": {"const": "REJECTED"}}, "required": ["ack_kind"]},
      "then": {"required": ["rejection_code"]},
      "else": {"not": {"required": ["rejection_code"]}}
    },
    {
      "if": {
        "properties": {"ack_kind": {"const": "ALREADY_TERMINAL"}},
        "required": ["ack_kind"]
      },
      "then": {"required": ["result_event_id"]},
      "else": {"not": {"required": ["result_event_id"]}}
    }
  ],
  "additionalProperties": false
}

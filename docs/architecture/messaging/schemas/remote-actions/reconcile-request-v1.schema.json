{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:juzhen:remote-actions:reconcile-request:v1",
  "title": "Remote action reconcile request v1",
  "type": "object",
  "$defs": {
    "active_work_order": {
      "type": "object",
      "properties": {
        "work_order_id": {"type": "string", "pattern": "^wo_[A-Za-z0-9_-]{1,77}$", "maxLength": 80},
        "lease_generation": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9_-]{1,76}$", "maxLength": 80},
        "status": {
          "enum": [
            "RECEIVED",
            "VALIDATING",
            "RUNNING",
            "VERIFYING",
            "RECONCILING",
            "CHECKPOINT_BLOCKED"
          ]
        }
      },
      "required": ["work_order_id", "lease_generation", "run_id", "status"],
      "additionalProperties": false
    }
  },
  "properties": {
    "last_server_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "active_work_orders": {
      "type": "array",
      "items": {"$ref": "#/$defs/active_work_order"},
      "maxItems": 256
    },
    "pending_result_event_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^evt_[A-Za-z0-9_-]{1,76}$", "maxLength": 80},
      "maxItems": 256,
      "uniqueItems": true
    }
  },
  "required": ["last_server_sequence", "active_work_orders", "pending_result_event_ids"],
  "additionalProperties": false
}
